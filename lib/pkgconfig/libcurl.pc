prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS IPFS IPNS MQTT MQTTS POP3 POP3S RTSP SMTP SMTPS TELNET TFTP WS WSS"
supported_features="alt-svc AsynchDNS HSTS HTTPS-proxy IPv6 Largefile libz SSL threadsafe UnixSockets zstd"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
License: curl
Copyright: Copyright (C) Daniel Stenberg, <daniel@haxx.se>, et al.
Version: 8.23.1-DEV
Source: https://curl.se/download/curl-8.23.1-DEV.tar.gz
Requires.private: libzstd
Libs: -L${libdir} -lcurl
Libs.private: -L/apex/lib -pthread -lssl -lcrypto -lz -lzstd
Cflags: -I${includedir}
Cflags.private: -DCURL_STATICLIB
Link.ABI: c
